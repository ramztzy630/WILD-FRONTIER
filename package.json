{
  "name": "wild-frontier",
  "private": true,
  "version": "0.1.0",
  "description": "WILD FRONTIER — 3D open-world survival adventure for mobile and desktop browsers",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  }
}
